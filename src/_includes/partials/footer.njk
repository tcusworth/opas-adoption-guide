<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="{{ '/assets/img/logo.png' | url }}" alt="{{ site.name }}" class="footer-logo">
      <p>{{ site.description }}</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {% for item in site.nav %}
          <li><a href="{{ item.url | url }}">{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
  <div class="footer-bar">
    <div class="wrap">
      <p>&copy; {{ '' | year }} {{ site.name }}. All rights reserved. FAQ content reproduced from <em>The Open Group O-PAS™ Adoption Guide, Version 2.0</em> (G269), &copy; 2026 The Open Group, used under license. O-PAS is a trademark of The Open Group.</p>
    </div>
  </div>
</footer>
